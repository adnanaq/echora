  "query": "\n        UPDATE episode\n        SET aired_notified_at = $2\n        WHERE id = $1\n          AND deleted_at IS NULL\n          AND aired_at IS NOT NULL\n          AND aired_at <= $2\n          AND aired_notified_at IS NULL\n        RETURNING anime_id, episode_number, aired_at, version\n        ",
