{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            ele.episode_id,\n            ele.provider,\n            ele.title,\n            ele.aired_at,\n            ele.duration_seconds,\n            ele.is_filler,\n            ele.is_recap\n        FROM episode_list_entry ele\n        JOIN episode e ON e.id = ele.episode_id\n        WHERE e.anime_id = $1 AND e.deleted_at IS NULL\n        ORDER BY ele.episode_id, ele.provider\n        ",
