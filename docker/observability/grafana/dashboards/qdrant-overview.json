{
  "id": null,
  "uid": "echora-qdrant-overview",
  "title": "Echora Qdrant Overview",
  "tags": [
    "echora",
    "qdrant"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"qdrant\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"qdrant\"}, instance)",
          "refId": "instance"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "collection",
        "label": "Collection",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(collection_points{job=\"qdrant\"}, id)",
        "query": {
          "query": "label_values(collection_points{job=\"qdrant\"}, id)",
          "refId": "collection"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Requests",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "gRPC Requests by Endpoint",
      "description": "Requests per second Qdrant answered over gRPC. The vector service uses gRPC when QDRANT_PREFER_GRPC is true.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(grpc_responses_total{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests by Endpoint",
      "description": "Requests per second Qdrant answered over its REST API (the vector service's default).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (method, endpoint) (rate(rest_responses_total{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m]))",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "gRPC Latency (p50 / p95)",
      "description": "Time Qdrant took to answer, measured inside Qdrant; excludes the network and the client.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(grpc_responses_duration_seconds_bucket{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m])))",
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(grpc_responses_duration_seconds_bucket{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m])))",
          "legendFormat": "p50 {{endpoint}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Latency (p50 / p95)",
      "description": "Time Qdrant took to answer REST requests, measured inside Qdrant.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(rest_responses_duration_seconds_bucket{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m])))",
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(rest_responses_duration_seconds_bucket{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m])))",
          "legendFormat": "p50 {{endpoint}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by Collection",
      "description": "gRPC and REST requests per second, per collection.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (collection) (rate(grpc_responses_total{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m]))",
          "legendFormat": "gRPC {{collection}}"
        },
        {
          "expr": "sum by (collection) (rate(rest_responses_total{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\"}[5m]))",
          "legendFormat": "HTTP {{collection}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Failed Requests",
      "description": "gRPC responses with a non-OK status, and REST responses with a 4xx or 5xx status.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (endpoint, status) (rate(grpc_responses_total{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\", status!=\"0\"}[5m]))",
          "legendFormat": "gRPC {{status}} {{endpoint}}"
        },
        {
          "expr": "sum by (endpoint, status) (rate(rest_responses_total{job=\"qdrant\", instance=~\"$instance\", collection=~\"$collection\", status=~\"4..|5..\"}[5m]))",
          "legendFormat": "HTTP {{status}} {{endpoint}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "type": "row",
      "title": "Resources",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU Cores Used",
      "description": "Average number of CPU cores the Qdrant process used over roughly the last two seconds (cpu_cores_used).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "cpu_cores_used{job=\"qdrant\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "description": "Resident memory (memory_resident_bytes) and memory allocated by Qdrant (memory_allocated_bytes).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "memory_resident_bytes{job=\"qdrant\", instance=~\"$instance\"}",
          "legendFormat": "resident {{instance}}"
        },
        {
          "expr": "memory_allocated_bytes{job=\"qdrant\", instance=~\"$instance\"}",
          "legendFormat": "allocated {{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU Work by Collection",
      "description": "Rate of collection_hardware_metric_cpu: Qdrant's own CPU measurement per collection. It has no unit, so compare collections and periods with each other. Reported only when service.hardware_reporting is on.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (id) (rate(collection_hardware_metric_cpu{job=\"qdrant\", instance=~\"$instance\", id=~\"$collection\"}[5m]))",
          "legendFormat": "{{id}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Collections",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Points by Collection",
      "description": "Approximate number of points in each collection.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "collection_points{job=\"qdrant\", instance=~\"$instance\", id=~\"$collection\"}",
          "legendFormat": "{{id}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Update Queue Length",
      "description": "Pending write operations per collection. A queue that keeps growing means writes arrive faster than Qdrant applies them.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "collection_update_queue_length{job=\"qdrant\", instance=~\"$instance\", id=~\"$collection\"}",
          "legendFormat": "{{id}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Running Optimizations",
      "description": "Optimization tasks (segment merging, indexing) running per collection; they use CPU that searches would otherwise get.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "collection_running_optimizations{job=\"qdrant\", instance=~\"$instance\", id=~\"$collection\"}",
          "legendFormat": "{{id}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    }
  ]
}
