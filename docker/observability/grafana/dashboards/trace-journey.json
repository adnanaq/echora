{
  "id": null,
  "uid": "echora-trace-journey",
  "title": "Echora Trace Journey",
  "tags": [
    "echora",
    "tempo",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(echora_rpc_requests_total, deployment_environment)",
        "query": {
          "query": "label_values(echora_rpc_requests_total, deployment_environment)",
          "refId": "environment"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "RPC Request Rate",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(echora_rpc_requests_total{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m]))",
          "legendFormat": "Requests/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RPC Latency P95 by Method",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(echora_rpc_duration_seconds_bucket{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m])) by (le, rpc_method))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    }
  ]
}
