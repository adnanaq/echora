{
  "id": null,
  "uid": "echora-service-overview",
  "title": "Echora Service Overview",
  "tags": [
    "echora",
    "observability",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(echora_rpc_requests_total, deployment_environment)",
        "query": {
          "query": "label_values(echora_rpc_requests_total, deployment_environment)",
          "refId": "environment"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate (RPC)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(echora_rpc_requests_total{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m]))",
          "legendFormat": "Requests/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (RPC)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(echora_rpc_errors_total{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m])) / clamp_min(sum(rate(echora_rpc_requests_total{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m])), 0.001)",
          "legendFormat": "Error ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency P99 (RPC)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(echora_rpc_duration_seconds_bucket{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Method",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (rpc_method) (rate(echora_rpc_requests_total{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate by Code",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (error_code) (rate(echora_rpc_errors_total{exported_job=\"echora-vector-service\", deployment_environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{error_code}}"
        }
      ]
    }
  ]
}
