# syntax=docker/dockerfile:1.6
# =============================================================================
# Agent Service — development image (uv multi-stage)
#
# Build:  docker compose -f docker/docker-compose.dev.yml build agent-service
# Run:    docker compose -f docker/docker-compose.dev.yml up -d agent-service
# =============================================================================

FROM python:3.14-slim AS deps

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv

WORKDIR /build

COPY pyproject.toml uv.lock ./

# Drop heavy ML/CUDA stacks unneeded by agent_service; --no-deps avoids re-resolving them.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --no-hashes --no-annotate \
        | grep -vE "^(#|torch|torchvision|triton|nvidia-|cuda-|accelerate|flagembedding|open-clip-torch|sentence-transformers|transformers|timm|peft|datasets|ir-datasets|safetensors|tokenizers|huggingface-hub|hf-xet|sentencepiece|sympy|mpmath|pyarrow)" \
        > /tmp/reqs-agent-service.txt \
 && uv venv .venv \
 && uv pip install --python .venv/bin/python --no-deps -r /tmp/reqs-agent-service.txt

FROM python:3.14-slim AS app

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && set -eux; \
       arch="${TARGETARCH:-amd64}"; \
       case "$arch" in \
         amd64) probe_arch="amd64"; probe_sha256="8302d54fc41d4ffbfea6871b6a04584265d5eabbe738aee2966f9a574b6f17d1" ;; \
         arm64) probe_arch="arm64"; probe_sha256="8ebe934e7cf29a65ca31d671a97949467fba6977d656b5e6d6c40902ae7402f6" ;; \
         *) echo "Unsupported arch for grpc_health_probe: $arch"; exit 1 ;; \
       esac; \
       curl -fsSL -o /usr/local/bin/grpc_health_probe \
         "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/v0.4.37/grpc_health_probe-linux-${probe_arch}"; \
       echo "${probe_sha256}  /usr/local/bin/grpc_health_probe" | sha256sum -c -; \
       chmod +x /usr/local/bin/grpc_health_probe

WORKDIR /app

COPY --from=deps /build/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY libs/common/src/            /app/libs/common/src/
COPY libs/work_matching/src/     /app/libs/work_matching/src/
COPY libs/match_suggestions/src/ /app/libs/match_suggestions/src/
COPY apps/agent_service/src/     /app/apps/agent_service/src/

ENV PYTHONPATH="/app/apps/agent_service/src:/app/libs/common/src:/app/libs/work_matching/src:/app/libs/match_suggestions/src"

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --create-home appuser \
    && mkdir -p /app/data/agent \
    && chown -R appuser:appuser /app

USER appuser

ENV PYTHONUNBUFFERED=1 \
    ENVIRONMENT=development \
    AGENT_SERVICE_HOST=0.0.0.0 \
    AGENT_SERVICE_PORT=8005

EXPOSE 8005

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD grpc_health_probe -addr=localhost:8005 || exit 1

ENTRYPOINT ["python", "-m", "agent_service.main"]
