# syntax=docker/dockerfile:1.6
# =============================================================================
# Enrichment Service — development image (uv multi-stage)
#
# Build:  docker compose -f docker/docker-compose.dev.yml build enrichment-service
# Run:    docker compose -f docker/docker-compose.dev.yml up -d enrichment-service
#
# No Pants step required. BuildKit caches the dependency layer separately from
# source so rebuilds after a code change take ~5-10 s instead of 10-15 min.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — install Python dependencies
# Only re-runs when pyproject.toml / uv.lock change, not on source edits.
# -----------------------------------------------------------------------------
FROM python:3.14-slim AS deps

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv

WORKDIR /build

COPY pyproject.toml uv.lock ./

# Shared lockfile includes torch for vector-service; install CPU-only torch
# first so uv does not pull the 4+ GB CUDA stack when resolving deps.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --no-hashes --no-annotate \
        | grep -vE "^(torch|triton|nvidia-|#)" > /tmp/reqs-cpu.txt \
 && uv venv .venv \
 && uv pip install --python .venv/bin/python \
        torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && uv pip install --python .venv/bin/python -r /tmp/reqs-cpu.txt

# -----------------------------------------------------------------------------
# Stage 2 — runtime image
# -----------------------------------------------------------------------------
FROM python:3.14-slim AS app

ARG TARGETARCH

# chromium and xvfb: the MAL, anime-planet and AniDB crawlers drive a real
# browser through zendriver, and AniDB opens a visible window (its Cloudflare
# check does not clear headless), so the browser needs a virtual screen.
# AniSearch is fetched over plain HTTP and needs neither.
RUN apt-get update && apt-get install -y --no-install-recommends curl chromium xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && set -eux; \
       arch="${TARGETARCH:-amd64}"; \
       case "$arch" in \
         amd64) probe_arch="amd64"; probe_sha256="8302d54fc41d4ffbfea6871b6a04584265d5eabbe738aee2966f9a574b6f17d1" ;; \
         arm64) probe_arch="arm64"; probe_sha256="8ebe934e7cf29a65ca31d671a97949467fba6977d656b5e6d6c40902ae7402f6" ;; \
         *) echo "Unsupported arch for grpc_health_probe: $arch"; exit 1 ;; \
       esac; \
       curl -fsSL -o /usr/local/bin/grpc_health_probe \
         "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/v0.4.37/grpc_health_probe-linux-${probe_arch}"; \
       echo "${probe_sha256}  /usr/local/bin/grpc_health_probe" | sha256sum -c -; \
       chmod +x /usr/local/bin/grpc_health_probe

WORKDIR /app

COPY --from=deps /build/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY libs/common/src/              /app/libs/common/src/
COPY libs/observability/src/       /app/libs/observability/src/
COPY libs/http_cache/src/          /app/libs/http_cache/src/
COPY libs/enrichment/src/          /app/libs/enrichment/src/
COPY apps/enrichment_service/src/  /app/apps/enrichment_service/src/

ENV PYTHONPATH="/app/apps/enrichment_service/src:/app/libs/common/src:/app/libs/observability/src:/app/libs/http_cache/src:/app/libs/enrichment/src"

# Xvfb running as appuser cannot create /tmp/.X11-unix itself. Chrome's own
# sandbox cannot start as a non-root user under Docker's default seccomp
# profile, so the container is the isolation boundary; Debian's chromium
# launcher reads extra flags from /etc/chromium.d/.
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --create-home appuser \
    && mkdir -p /app/temp \
    && chown -R appuser:appuser /app \
    && mkdir -p /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix \
    && echo 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox"' > /etc/chromium.d/no-sandbox

USER appuser

ENV PYTHONUNBUFFERED=1 \
    ENVIRONMENT=development \
    DISPLAY=:99

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD grpc_health_probe -addr=localhost:8002 || exit 1

ENTRYPOINT ["sh", "-c", "Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp & exec python -m enrichment_service.main"]
