# syntax=docker/dockerfile:1.6
# =============================================================================
# Review Page — development image (uv multi-stage)
#
# Build:  docker compose -f docker/docker-compose.dev.yml build review-page
# Run:    docker compose -f docker/docker-compose.dev.yml up -d review-page
#
# The page serves seed cleaning's review cases and starts
# `scripts/clean_seed.py --no-fetch` for Run, so the image holds that script
# and the libraries it imports. A run fetches nothing, so the image needs no
# browser, and it loads no embedding model, so it leaves the model stack out.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — install Python dependencies
# Only re-runs when pyproject.toml / uv.lock change, not on source edits.
# -----------------------------------------------------------------------------
FROM python:3.14-slim AS deps

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv

WORKDIR /build

COPY pyproject.toml uv.lock ./

# The shared lockfile holds the vector service's embedding models (torch and
# CUDA, several GB). The page and a seed-cleaning run import none of them, so
# they are dropped, and --no-deps keeps uv from resolving them back in.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --no-hashes --no-annotate \
        | grep -vE "^(#|torch|torchvision|triton|nvidia-|cuda-|accelerate|flagembedding|open-clip-torch|sentence-transformers|transformers|timm|peft|datasets|ir-datasets|safetensors|tokenizers|huggingface-hub|hf-xet|sentencepiece|sympy|mpmath|pyarrow)" \
        > /tmp/reqs-review-page.txt \
 && uv venv .venv \
 && uv pip install --python .venv/bin/python --no-deps -r /tmp/reqs-review-page.txt

# -----------------------------------------------------------------------------
# Stage 2 — runtime image
# -----------------------------------------------------------------------------
FROM python:3.14-slim AS app

WORKDIR /app

COPY --from=deps /build/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY libs/common/src/          /app/libs/common/src/
COPY libs/observability/src/   /app/libs/observability/src/
COPY libs/http_cache/src/      /app/libs/http_cache/src/
COPY libs/enrichment/src/      /app/libs/enrichment/src/
COPY libs/work_matching/src/   /app/libs/work_matching/src/
COPY libs/seed_cleaning/src/   /app/libs/seed_cleaning/src/
COPY scripts/clean_seed.py     /app/scripts/clean_seed.py
COPY apps/review_page/src/     /app/apps/review_page/src/

ENV PYTHONPATH="/app/apps/review_page/src:/app/libs/common/src:/app/libs/observability/src:/app/libs/http_cache/src:/app/libs/enrichment/src:/app/libs/work_matching/src:/app/libs/seed_cleaning/src"

# appuser has uid 1000, like the usual host user, so the files a save or a run
# writes in the mounted data folder stay owned by the person running the stack.
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --create-home appuser \
    && mkdir -p /app/data/seed_cleaning /app/assets/seed_data \
    && chown -R appuser:appuser /app

USER appuser

ENV PYTHONUNBUFFERED=1 \
    ENVIRONMENT=development \
    REVIEW_PAGE_HOST=0.0.0.0 \
    REVIEW_PAGE_PORT=8003

EXPOSE 8003

# Python's urllib, so the image needs no curl.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"REVIEW_PAGE_PORT\"]}/health', timeout=5)" || exit 1

ENTRYPOINT ["python", "-m", "review_page.main"]
