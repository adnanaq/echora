# syntax=docker/dockerfile:1.6
# =============================================================================
# PostgreSQL Service — production image (multi-stage Rust build)
#
# Build via Pants: ./pants package crates/postgres_service:postgres-service-image
# Build directly:  docker build -f crates/postgres_service/Dockerfile.prd .
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — build release binary
# -----------------------------------------------------------------------------
FROM rust:1-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY .sqlx/ .sqlx/
COPY protos/ protos/
COPY crates/common/ crates/common/
COPY crates/postgres_db/ crates/postgres_db/
COPY crates/postgres_service/ crates/postgres_service/
COPY crates/temporal_workflows/ crates/temporal_workflows/
COPY crates/update_service/ crates/update_service/

ENV RUSTFLAGS="-C target-cpu=x86-64-v3" \
    SQLX_OFFLINE=true

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release --locked -p postgres_service \
    && cp /build/target/release/postgres_service /usr/local/bin/postgres_service

# -----------------------------------------------------------------------------
# Stage 2 — minimal non-root runtime image
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS app

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && set -eux; \
       arch="${TARGETARCH:-amd64}"; \
       case "$arch" in \
         amd64) probe_arch="amd64"; probe_sha256="8302d54fc41d4ffbfea6871b6a04584265d5eabbe738aee2966f9a574b6f17d1" ;; \
         arm64) probe_arch="arm64"; probe_sha256="8ebe934e7cf29a65ca31d671a97949467fba6977d656b5e6d6c40902ae7402f6" ;; \
         *) echo "Unsupported arch for grpc_health_probe: $arch"; exit 1 ;; \
       esac; \
       curl -fsSL -o /usr/local/bin/grpc_health_probe \
         "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/v0.4.37/grpc_health_probe-linux-${probe_arch}"; \
       echo "${probe_sha256}  /usr/local/bin/grpc_health_probe" | sha256sum -c -; \
       chmod +x /usr/local/bin/grpc_health_probe

COPY --from=builder /usr/local/bin/postgres_service /usr/local/bin/postgres_service

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --no-create-home appuser

USER appuser

ENV ENVIRONMENT=production \
    POSTGRES_SERVICE_HOST=0.0.0.0 \
    POSTGRES_SERVICE_PORT=8004

EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD grpc_health_probe -addr=localhost:8004 || exit 1

ENTRYPOINT ["/usr/local/bin/postgres_service"]
